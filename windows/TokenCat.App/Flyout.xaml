<!-- The tray flyout (DESIGN §4.2): borderless, topmost, no taskbar button, 420 DIP wide, sized to the dashboard. No
     AllowsTransparency: that makes a layered, software-rendered window. Rounded corners come from DWM (Native.StyleWindow). -->
<Window x:Class="TokenCat.Flyout" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TokenCat" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Width="420"
        SizeToContent="Height" ShowActivated="True" />
